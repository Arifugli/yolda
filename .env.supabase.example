# Server environment only. Never prefix credentials with NEXT_PUBLIC_.
# Copy the Session pooler PostgreSQL URI from the project's Connect panel.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_DB_PASSWORD@POOLER_HOST:5432/postgres
DATABASE_SSL=true
DB_POOL_MAX=5
# Official Supabase production roots are bundled. Optional project-specific CA override:
# Keep certificate verification enabled. Literal \n is supported.
DATABASE_CA_CERT=
STORAGE_DRIVER=supabase
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=yolda-private
APP_MODE=demo
DEPLOYMENT_ENV=development
NEXT_PUBLIC_APP_NAME=Yolda
APP_ORIGIN=https://YOUR_APP_HOST
# Required on cloud hosts: persistent, random 32-byte hex key (64 characters).
APP_ENCRYPTION_KEY=
# A second, shared login protects the demo accounts from public access.
DEMO_ACCESS_USER=demo
DEMO_ACCESS_PASSWORD=
