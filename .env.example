DATABASE_URL=postgres://yolda:yolda_local@localhost:5432/yolda
APP_MODE=demo
NEXT_PUBLIC_APP_NAME=Yolda
STORAGE_DIR=./storage
# Private S3-compatible object storage; defaults below are LOCAL DEMO ONLY.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=yolda-private
S3_ACCESS_KEY=S3RVER
S3_SECRET_KEY=S3RVER
# Set production deployment explicitly; demo providers will refuse to operate.
DEPLOYMENT_ENV=development
# Production requires a securely supplied 32-byte hex key; never commit a value.
# Demo generates a persistent private key in the ignored storage directory.
APP_ENCRYPTION_KEY=
# Set the externally served origin when behind a reverse proxy.
APP_ORIGIN=
