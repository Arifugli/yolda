{
  "name": "yolda",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "test": "tsx --env-file-if-exists=.env --test --test-concurrency=1 tests/*.test.ts",
    "storage:prepare": "tsx --env-file-if-exists=.env scripts/storage.ts",
    "supabase:check": "tsx --env-file-if-exists=.env scripts/supabase-check.ts",
    "supabase:preflight": "tsx --env-file-if-exists=.env scripts/supabase-preflight.ts",
    "supabase:sql": "tsx scripts/supabase-sql.ts",
    "storage:dev": "tsx --env-file-if-exists=.env scripts/object-store.ts",
    "test:e2e": "playwright test",
    "cloud:compose": "tsx scripts/cloud-compose.ts",
    "dispatch:worker": "tsx --env-file-if-exists=.env scripts/dispatch-worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@fontsource/manrope": "^5.3.0",
    "leaflet": "^1.9.4",
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/leaflet": "^1.9.20",
    "@types/node": "^24",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/s3rver": "^3.7.4",
    "prettier": "^3.9.10",
    "s3rver": "^3.7.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "type": "module"
}
